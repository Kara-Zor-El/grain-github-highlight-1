{
  "name": "github-grain-highlight",
  "version": "2.0.0",
  "description": "Grain syntax highlighter for github",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist .wxt",
    "postinstall": "wxt prepare && cp node_modules/web-tree-sitter/web-tree-sitter.wasm public/web-tree-sitter.wasm",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "pack": "npm run pack:chrome && npm run pack:firefox",
    "pack:chrome": "wxt zip",
    "pack:firefox": "wxt zip -b firefox"
  },
  "author": "spotandjake",
  "contributors": [
    "Kara-Zor-El <kara.wilson.2005.08@gmail.com>"
  ],
  "license": "MIT",
  "devDependencies": {
    "@treelight/browser": "^0.5.0",
    "@treelight/theme-github-dark": "^0.5.0",
    "@types/chrome": "^0.2.5",
    "prettier": "3.5.0",
    "typescript": "^5.9.2",
    "wxt": "^0.21.3"
  }
}
